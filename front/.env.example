# URL de la API que usa el navegador.
# Por defecto "/api": next.config.ts redirige /api/:path* al backend (ver BACKEND_URL).
NEXT_PUBLIC_API_URL=/api

# URL del backend que usa el servidor de Next.js para los rewrites /api/:path*.
# En local, el backend corre en http://localhost:3000 (ver back/.env.example).
# En producción es la URL de Railway, p. ej. https://zentra-backend-production-8613.up.railway.app
BACKEND_URL=http://localhost:3000
